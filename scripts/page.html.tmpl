<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{NAME}} at Kunming University of Science and Technology. {{INTRODUCTION}}">
{{ROBOTS}}
  <title>{{NAME}} — {{AFFILIATION}}</title>
  <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
{{PREVIEW}}
  <header class="site-header">
    <a class="brand" href="#home" aria-label="{{NAME}} home"><span class="brand-symbol" aria-hidden="true">{{SHORT_NAME}}</span><span>{{NAME}}<small>{{AFFILIATION}}</small></span></a>
    <nav aria-label="Main navigation"><a href="#research">Research</a><a href="#people">People</a><a href="#news">News</a><a href="#publications">Publications</a><a class="nav-contact" href="#contact">Join us <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main id="main">
    <section class="hero" id="home" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">{{NAME}}</h1>
        <p class="hero-subtitle">{{HEADLINE}}</p>
        <p class="intro">{{INTRODUCTION}}</p>
        <a class="text-link" href="#research">Explore our research <span aria-hidden="true">↘</span></a>
      </div>
      <figure class="voyager">
        <div class="voyager-image">
          <img src="assets/voyager-pale-blue-dot.jpg" width="1000" height="989"
               alt="Earth appears as a tiny speck of light in a pale sunbeam on the right.">
        </div>
        <figcaption>
          <span class="voyager-title">Pale Blue Dot</span>
          <span>Voyager 1 · 14 February 1990</span>
          <span class="voyager-note">The speck in the sunbeam is Earth, seen from six billion kilometers away.</span>
          <a href="https://www.jpl.nasa.gov/images/pia23645-pale-blue-dot-revisited/">NASA/JPL-Caltech · 2020 edition <span aria-hidden="true">↗</span></a>
        </figcaption>
      </figure>
    </section>
    <section class="section wrap" id="research" aria-labelledby="research-title">
      <h2 id="research-title">Research</h2>
      <div class="research-list">{{RESEARCH}}</div>
    </section>
    <section class="people-section" id="people" aria-labelledby="people-title">
      <div class="wrap">
        <div class="section-title-row"><h2 id="people-title">People</h2></div>
        <div class="people-grid">{{PEOPLE}}</div>
        <section class="students-section" id="group-members" aria-labelledby="students-title">
          <h3 id="students-title">Group Members</h3>
          <div class="students-grid">{{MEMBERS}}</div>
          {{STUDENTS}}
        </section>
        {{ALUMNI}}
      </div>
    </section>
    <section class="section wrap news-section" id="news" aria-labelledby="news-title">
      <h2 id="news-title">News</h2>
      <div class="news-list">{{NEWS_ITEMS}}</div>
    </section>
    <section class="wrap bibliography" id="publications" aria-labelledby="publications-title">
      <h2 id="publications-title">Publications</h2>
      <p class="correspondence-key">* Corresponding author</p>
      <nav class="year-nav" aria-label="Browse by publication year">{{YEAR_LINKS}}</nav>
      {{YEAR_SECTIONS}}
    </section>
    <section class="contact-section" id="contact" aria-labelledby="contact-title">
      <figure class="contact-photo">
        <img src="assets/group-hike-dianchi-2026.jpg" width="1706" height="1279" loading="lazy"
             alt="Research group members standing together on the shore of Dianchi Lake.">
        <figcaption>Group hike at Dianchi Lake · <time datetime="2026-05-29">29 May 2026</time></figcaption>
      </figure>
      <h2 id="contact-title">Join us &amp; contact</h2>
      <div class="contact-details"><p>{{OPPORTUNITIES}}</p>{{CONTACT}}</div>
    </section>
  </main>
  <footer class="wrap"><span>{{NAME}}</span><span>{{AFFILIATION}}</span><a href="#home">Back to top ↑</a></footer>
</body>
</html>
